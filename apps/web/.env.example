# Feature flags for hiding/showing specific models
NEXT_PUBLIC_FIREWORKS_ENABLED=true
NEXT_PUBLIC_GEMINI_ENABLED=true
NEXT_PUBLIC_ANTHROPIC_ENABLED=true
NEXT_PUBLIC_OPENAI_ENABLED=true
# Set to false by default since the base OpenAI API is more common than the Azure OpenAI API.
NEXT_PUBLIC_AZURE_ENABLED=false
NEXT_PUBLIC_OLLAMA_ENABLED=false
NEXT_PUBLIC_GROQ_ENABLED=false

# If using Ollama, set the API URL here. Only needs to be set if using the non default Ollama server port.
# It will default to `http://host.docker.internal:11434` if not set.
# OLLAMA_API_URL="http://host.docker.internal:11434"

# Supabase for authentication
# Public keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# For document uploading (can be the same as the above keys)
NEXT_PUBLIC_SUPABASE_URL_DOCUMENTS=
NEXT_PUBLIC_SUPABASE_ANON_KEY_DOCUMENTS=

# Universal workspace server configuration
EVALUCHAT_WORKSPACE_ASSISTANT_ID=
# EVALUCHAT_TEMPLATE_CATALOG_PATH=/opt/evaluchat-catalog/current

# GitHub private research workspaces (server-only; unset/default is disabled)
# GITHUB_RESEARCH_WORKSPACES_ENABLED=true
# Repository assistant stays inert unless explicitly enabled; its graph also
# refuses runs whenever LangSmith tracing is enabled.
# GITHUB_RESEARCH_REPOSITORY_AI_ENABLED=
# GITHUB_RESEARCH_APP_ID=
# GITHUB_RESEARCH_APP_PRIVATE_KEY=
# GITHUB_RESEARCH_APP_CLIENT_ID=
# GITHUB_RESEARCH_APP_CLIENT_SECRET=
# GITHUB_RESEARCH_APP_WEBHOOK_SECRET=
# GITHUB_RESEARCH_OAUTH_REDIRECT_URL=
# GITHUB_RESEARCH_STARTER_TEMPLATE=evaluchat/private-research-starter
# GITHUB_RESEARCH_TOKEN_ENCRYPTION_KEY=
# GITHUB_RESEARCH_TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# Catalogue publisher app (separate from the user research app). Wiring an
# installation-scoped token is a maintainer step; runtime still uses
# VALERY_GITHUB_TOKEN until that resolver exists.
# GITHUB_CATALOGUE_APP_ID=
# GITHUB_CATALOGUE_PRIVATE_KEY=

# E2E test auth bypass (local/CI only). Leave unset in deployments.
# Server checks E2E_TEST_MODE; client checks NEXT_PUBLIC_E2E_TEST_MODE.
# Both must be "true" AND the __e2e_test__=true cookie must be set.
# E2E_TEST_MODE=true
# NEXT_PUBLIC_E2E_TEST_MODE=true

# BYOK: server-side AES-256-GCM key for user-provided LLM API keys (64 hex chars)
# Generate: openssl rand -hex 32
BYOK_ENCRYPTION_KEY=

# For transcription
GROQ_API_KEY=

# For web scraping
FIRECRAWL_API_KEY=

# Azure OpenAI Configuration
# ENSURE THEY ARE PREFIXED WITH AN UNDERSCORE.
# _AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# _AZURE_OPENAI_API_INSTANCE_NAME=your-instance-name
# _AZURE_OPENAI_API_DEPLOYMENT_NAME=your-deployment-name
# _AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Optional: Azure OpenAI Base Path (if using a different domain)
# _AZURE_OPENAI_API_BASE_PATH=https://your-custom-domain.com/openai/deployments
