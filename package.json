  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "fast-xml-parser": ">=5.3.6",
    "form-data": ">=4.0.4",
    "axios": ">=1.13.5",
    "tar": ">=7.5.8",
    "hono": ">=4.11.4",
    "linkifyjs": ">=4.3.2",
    "glob": ">=10.5.0 <11",
    "js-yaml": ">=4.3.1 <5",
    "langsmith": ">=0.6.0 <1",
    "postcss": ">=8.5.18 <9",
    "sharp": ">=0.35.0 <1",
    "ws": ">=8.21.0 <9",
    "glob/minimatch": ">=9.0.7 <10",
    "glob/minimatch/brace-expansion": ">=5.0.9 <6",
    "tailwindcss/micromatch/picomatch": ">=2.3.2 <3",
    "tailwindcss/chokidar/anymatch/picomatch": ">=2.3.2 <3",
    "micromatch/picomatch": ">=2.3.2 <3",
    "anymatch/picomatch": ">=2.3.2 <3",
    "**/linkify-it": ">=5.0.2 <6",
    "postcss/nanoid": ">=3.3.17 <4",
    "next/postcss/nanoid": ">=3.3.17 <4",
