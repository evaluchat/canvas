    "generate:workspace-templates": "tsx scripts/generate-workspace-template-catalog.ts",
    "deploy:oss-dev": "bash scripts/oss-dev-deploy.sh",
    "build": "turbo build",
    "turbo:command": "turbo",
    "format": "turbo format",
    "format:check": "turbo format:check",
